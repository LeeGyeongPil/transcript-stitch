{
  "name": "transcript-stitch",
  "version": "0.2.0",
  "description": "Plan size-safe audio chunks for speech-to-text APIs and stitch the per-chunk transcripts back into one timeline (offset fix, overlap de-duplication, SRT/VTT). Zero runtime dependencies.",
  "keywords": ["whisper", "transcription", "speech-to-text", "stt", "srt", "vtt", "chunking", "openai", "groq", "whisper.cpp", "subtitles"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "transcript-stitch": "dist/cli.js"
  },
  "files": ["dist", "fixtures", "examples", "README.md", "README.ko.md", "CHANGELOG.md", "LICENSE"],
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "predemo": "npm run build",
    "demo": "node dist/cli.js demo --lang en",
    "demo:ko": "node dist/cli.js demo --lang ko",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run build && npm run check:package && vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "subsrt-ts": "2.1.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
